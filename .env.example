#──────────────────────────────────────────────────────────────────────────────
# Application
#──────────────────────────────────────────────────────────────────────────────
# APP_NAME is the single source of truth for the product name (UI, mails,
# page titles, metadata, PDFs). Change it here and nowhere else.
APP_NAME=Matchly
APP_ENV=local
APP_KEY=
# Comma-separated old keys, so encrypted columns/files survive a key rotation.
APP_PREVIOUS_KEYS=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# Proxies whose X-Forwarded-* headers are trusted ("*" behind Caddy/a PaaS LB).
TRUSTED_PROXIES=*

#──────────────────────────────────────────────────────────────────────────────
# Security headers
#──────────────────────────────────────────────────────────────────────────────
# CSP defaults to off in local (Vite HMR) and on everywhere else.
SECURITY_CSP_ENABLED=false
SECURITY_CSP_REPORT_ONLY=false
# Extra connect-src origins, e.g. the public Reverb websocket URL.
SECURITY_CSP_CONNECT_SRC=ws://localhost:8080
SECURITY_HSTS_ENABLED=false

#──────────────────────────────────────────────────────────────────────────────
# Logging (stderr so Docker/PaaS collect it; "daily" rotates files on a VPS)
#──────────────────────────────────────────────────────────────────────────────
LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

#──────────────────────────────────────────────────────────────────────────────
# Database (PostgreSQL; hosts are Docker service names)
#──────────────────────────────────────────────────────────────────────────────
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=app
DB_USERNAME=app
DB_PASSWORD=secret

#──────────────────────────────────────────────────────────────────────────────
# Redis: cache, queues (Horizon), sessions, rate limiting
#──────────────────────────────────────────────────────────────────────────────
REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

CACHE_STORE=redis
CACHE_PREFIX=
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_LIFETIME=120
SESSION_ENCRYPT=true
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=false

# Comma-separated e-mails allowed into /horizon outside local.
HORIZON_ADMIN_EMAILS=

#──────────────────────────────────────────────────────────────────────────────
# Real time (Laravel Reverb)
#──────────────────────────────────────────────────────────────────────────────
BROADCAST_CONNECTION=reverb

REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
# Where the app (PHP) reaches Reverb: the Docker service name in dev.
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
# Where Reverb itself listens inside its container.
REVERB_SERVER_HOST=0.0.0.0
REVERB_SERVER_PORT=8080

# Where the browser reaches Reverb. Sent to the page at runtime (not baked into
# the bundle), so one image serves every environment. VITE_REVERB_HOST/PORT/
# SCHEME from older .env files are still read as a fallback.
REVERB_PUBLIC_HOST=localhost
REVERB_PUBLIC_PORT=8080
REVERB_PUBLIC_SCHEME=http

#──────────────────────────────────────────────────────────────────────────────
# Mail (Mailpit in dev: http://localhost:8025). Production: resend|smtp (Brevo)
#──────────────────────────────────────────────────────────────────────────────
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"
RESEND_API_KEY=

#──────────────────────────────────────────────────────────────────────────────
# Storage (local in dev, S3-compatible in production). User files are also
# encrypted by the application before being written.
#──────────────────────────────────────────────────────────────────────────────
FILESYSTEM_DISK=local
# Disk for CVs and imports: "local" (storage/app/private) or "s3".
USER_FILES_DISK=local
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_USE_PATH_STYLE_ENDPOINT=false

#──────────────────────────────────────────────────────────────────────────────
# OAuth login (Socialite) — optional. Callback URLs to register with each
# provider: ${APP_URL}/auth/google/callback and ${APP_URL}/auth/github/callback
#──────────────────────────────────────────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

#──────────────────────────────────────────────────────────────────────────────
# GitHub API (public profile analysis). A token raises the rate limit from
# 60 to 5000 requests/hour; no scopes are needed for public data.
#──────────────────────────────────────────────────────────────────────────────
GITHUB_API_TOKEN=
# Optional tuning (defaults shown):
# GITHUB_RECENT_MONTHS=36
# GITHUB_MAX_REPOSITORIES=20
# GITHUB_CACHE_TTL=604800

#──────────────────────────────────────────────────────────────────────────────
# LinkedIn data export (ZIP upload; LinkedIn itself is never contacted)
#──────────────────────────────────────────────────────────────────────────────
LINKEDIN_MAX_UPLOAD_KB=51200

#──────────────────────────────────────────────────────────────────────────────
# Job sources (free). Keyless sources are enabled by default.
#──────────────────────────────────────────────────────────────────────────────
# Postings older than this are never stored nor shown.
JOBS_MAX_AGE_DAYS=30
JOBS_PER_PAGE=20
JOBS_LINK_CHECK_INTERVAL_DAYS=3
# Per-source switches (all keyless sources default to on):
# JOBS_REMOTIVE_ENABLED, JOBS_REMOTEOK_ENABLED, JOBS_JOBICY_ENABLED, JOBS_HIMALAYAS_ENABLED,
# JOBS_ARBEITNOW_ENABLED, JOBS_WEWORKREMOTELY_ENABLED, JOBS_GREENHOUSE_ENABLED, JOBS_LEVER_ENABLED,
# JOBS_ASHBY_ENABLED, JOBS_WORKABLE_ENABLED, JOBS_SMARTRECRUITERS_ENABLED
# Adzuna and Jooble switch on automatically once their key is set.
ADZUNA_APP_ID=
ADZUNA_APP_KEY=
ADZUNA_COUNTRIES=gb,us,de,es,fr,nl,ca,au,br
JOOBLE_API_KEY=
# JSearch (Google Jobs): free plan is 200 requests/month; it switches on once the key is set.
JSEARCH_API_KEY=
JSEARCH_QUERY="remote developer"
# Quota window start/reset date from the OpenWeb Ninja dashboard (YYYY-MM-DD); empty = calendar month.
JSEARCH_QUOTA_RESETS_ON=
# Google Jobs (same account key unless set): 100 requests per 31 days.
GOOGLEJOBS_API_KEY=
GOOGLEJOBS_QUERY="remote developer"
GOOGLEJOBS_QUOTA_RESETS_ON=
# LinkedIn jobs (same account key unless set): 200 requests per 30 days.
LINKEDIN_API_KEY=
LINKEDIN_QUERY="remote developer"
LINKEDIN_QUOTA_RESETS_ON=
# Bing Jobs (same account key unless set): 200 requests per 30 days.
BINGJOBS_API_KEY=
BINGJOBS_QUERY="remote developer"
BINGJOBS_QUOTA_RESETS_ON=

#──────────────────────────────────────────────────────────────────────────────
# AI providers (fallback order is configurable in config/ai.php)
#──────────────────────────────────────────────────────────────────────────────
AI_ENABLED=true
AI_FALLBACK_ORDER=anthropic,openai,deepseek,gemini,groq,huggingface,openrouter,nvidia,mistral,ollama
# Per-user budget for calls made with the server's keys; system tasks share their own.
AI_MONTHLY_BUDGET_USD_PER_USER=2.00
AI_SYSTEM_MONTHLY_BUDGET_USD=20.00
AI_USER_RATE_LIMIT=30
# Job requirement extraction with AI: lazy (jobs someone opens), all, off. Rules always run.
AI_JOB_REQUIREMENTS=lazy

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-5-5
ANTHROPIC_MODEL_QUALITY=claude-sonnet-5-5
# Paid (best writing): ANTHROPIC_API_KEY above, OPENAI_API_KEY here.
OPENAI_API_KEY=
# Free or cheap: DeepSeek, Gemini, Groq, Hugging Face and OpenRouter (:free models).
# Every *_API_KEY accepts several keys separated by commas; they are used in rotation
# so the free quota of each one adds up (e.g. HUGGINGFACE_API_KEY=hf_aaa,hf_bbb).
DEEPSEEK_API_KEY=
GEMINI_API_KEY=
GROQ_API_KEY=
HUGGINGFACE_API_KEY=
OPENROUTER_API_KEY=
NVIDIA_API_KEY=
MISTRAL_API_KEY=
# Local Ollama (OpenAI-compatible endpoint), e.g. http://host.docker.internal:11434/v1
OLLAMA_BASE_URL=
# Model overrides per tier are optional: GEMINI_MODEL_FAST, GROQ_MODEL_QUALITY, OPENROUTER_MODEL_FAST, ...

#──────────────────────────────────────────────────────────────────────────────
# Compatibility score weights (normalised; defaults shown)
#──────────────────────────────────────────────────────────────────────────────
# MATCHING_WEIGHT_SKILLS=40
# MATCHING_WEIGHT_EXPERIENCE=20
# MATCHING_WEIGHT_ROLE=15
# MATCHING_WEIGHT_LOCATION=10
# MATCHING_WEIGHT_LANGUAGES=5
# MATCHING_WEIGHT_SALARY=5
# MATCHING_WEIGHT_EDUCATION=5

#──────────────────────────────────────────────────────────────────────────────
# Privacy (GDPR)
#──────────────────────────────────────────────────────────────────────────────
# Bump when the privacy policy changes in a way that requires new consent.
PRIVACY_POLICY_VERSION=2026-10
PRIVACY_UNVERIFIED_ACCOUNT_DAYS=30
PRIVACY_INACTIVE_CV_TEXT_MONTHS=24
PRIVACY_UNREVIEWED_IMPORT_DAYS=30
PRIVACY_READ_NOTIFICATION_DAYS=90

#──────────────────────────────────────────────────────────────────────────────
# Search (optional Meilisearch: docker compose --profile search up)
#──────────────────────────────────────────────────────────────────────────────
SCOUT_DRIVER=null
MEILISEARCH_HOST=http://meilisearch:7700
MEILISEARCH_KEY=

#──────────────────────────────────────────────────────────────────────────────
# Frontend (Vite)
#──────────────────────────────────────────────────────────────────────────────
VITE_PORT=5173
VITE_DOCKER=true
VITE_HMR_HOST=localhost

#──────────────────────────────────────────────────────────────────────────────
# Docker (development). Host ports are configurable to avoid clashes.
#──────────────────────────────────────────────────────────────────────────────
COMPOSE_PROJECT_NAME=jobs-platform
# Match your host user so files created in containers stay yours (id -u / id -g).
HOST_UID=1000
HOST_GID=1000
APP_PORT=8000
FORWARD_DB_PORT=5432
FORWARD_REDIS_PORT=6379
FORWARD_REVERB_PORT=8080
FORWARD_MAILPIT_PORT=8025
FORWARD_MEILISEARCH_PORT=7700
# Set to "debug" (or "debug,coverage") to enable Xdebug in the dev image.
XDEBUG_MODE=off

# Days after applying with no answer before a follow-up reminder is sent.
FOLLOW_UP_DAYS=10
# Days before a deadline the person set on an application that they are warned.
DEADLINE_WARNING_DAYS=2
