# Production (and staging) values that differ from .env.example. Copy it to the
# server as .env next to docker-compose.prod.yml, or enter the same variables in
# your platform's dashboard (Laravel Cloud, Railway, Render, Fly.io secrets).
# Never commit the real file. Everything not listed keeps its .env.example default.

APP_NAME=Matchly
APP_ENV=production
APP_DEBUG=false
# php artisan key:generate --show   (one per environment; keep the old one in
# APP_PREVIOUS_KEYS when rotating so encrypted data stays readable)
APP_KEY=
APP_URL=https://matchly.example.com
APP_LOCALE=es

# docker-compose.prod.yml only
APP_DOMAIN=matchly.example.com
ACME_EMAIL=ops@example.com
APP_IMAGE=ghcr.io/dmarsal90/matchly
# Written by deploy/vps/deploy.sh; the image tag currently running.
APP_TAG=latest
BACKUP_KEEP_DAYS=14
BACKUP_AT=03:30

TRUSTED_PROXIES=*
SECURITY_CSP_ENABLED=true
SECURITY_HSTS_ENABLED=true
LOG_CHANNEL=stderr
LOG_LEVEL=info

# Compose service names, or your managed database / Redis hosts.
DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=matchly
DB_USERNAME=matchly
DB_PASSWORD=
# Managed PostgreSQL over TLS: DB_SSLMODE=require
# A single URL works too (Railway, Render, Fly): DB_URL=postgres://user:pass@host:5432/db

REDIS_HOST=redis
REDIS_PASSWORD=
# REDIS_URL=rediss://default:pass@host:6379

CACHE_STORE=redis
QUEUE_CONNECTION=redis
SESSION_DRIVER=redis
SESSION_SECURE_COOKIE=true
HORIZON_ADMIN_EMAILS=ops@example.com

# Real time: PHP talks to Reverb inside the network, browsers through Caddy.
BROADCAST_CONNECTION=reverb
REVERB_APP_ID=
REVERB_APP_KEY=
REVERB_APP_SECRET=
REVERB_HOST=reverb
REVERB_PORT=8080
REVERB_SCHEME=http
REVERB_PUBLIC_HOST=matchly.example.com
REVERB_PUBLIC_PORT=443
REVERB_PUBLIC_SCHEME=https

# Mail: Resend (API key) or any SMTP relay such as Brevo. SPF, DKIM and DMARC:
# docs/email-deliverability.md
MAIL_MAILER=resend
RESEND_API_KEY=
MAIL_FROM_ADDRESS=hello@matchly.example.com
MAIL_FROM_NAME="${APP_NAME}"

# User files: keep "local" with the compose "storage" volume, or move to S3.
FILESYSTEM_DISK=local
USER_FILES_DISK=local
# AWS_ACCESS_KEY_ID= AWS_SECRET_ACCESS_KEY= AWS_DEFAULT_REGION= AWS_BUCKET= AWS_ENDPOINT=

GITHUB_API_TOKEN=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

AI_ENABLED=true
ANTHROPIC_API_KEY=
