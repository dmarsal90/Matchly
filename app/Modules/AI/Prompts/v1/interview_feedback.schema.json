{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["strengths", "improvements"],
  "properties": {
    "strengths": {
      "type": "array",
      "maxItems": 3,
      "items": {"type": "string", "minLength": 5, "maxLength": 250}
    },
    "improvements": {
      "type": "array",
      "maxItems": 4,
      "items": {"type": "string", "minLength": 5, "maxLength": 250}
    }
  }
}
