<?xml version="1.0" encoding="UTF-8"?>
<phpunit xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:noNamespaceSchemaLocation="vendor/phpunit/phpunit/phpunit.xsd"
         bootstrap="tests/bootstrap.php"
         colors="true"
>
    <testsuites>
        <testsuite name="Unit">
            <directory>tests/Unit</directory>
        </testsuite>
        <testsuite name="Feature">
            <directory>tests/Feature</directory>
        </testsuite>
        <testsuite name="Architecture">
            <directory>tests/Architecture</directory>
        </testsuite>
    </testsuites>
    <source>
        <include>
            <directory>app</directory>
        </include>
    </source>
    <php>
        <!-- Docker injects .env as real environment variables, which Laravel reads from
             $_SERVER first; force both so tests never touch the dev database or Redis. -->
        <env name="APP_ENV" value="testing" force="true"/>
        <server name="APP_ENV" value="testing" force="true"/>
        <env name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <server name="APP_MAINTENANCE_DRIVER" value="file" force="true"/>
        <env name="BCRYPT_ROUNDS" value="4" force="true"/>
        <server name="BCRYPT_ROUNDS" value="4" force="true"/>
        <env name="BROADCAST_CONNECTION" value="null" force="true"/>
        <server name="BROADCAST_CONNECTION" value="null" force="true"/>
        <env name="CACHE_STORE" value="array" force="true"/>
        <server name="CACHE_STORE" value="array" force="true"/>
        <env name="DB_CONNECTION" value="sqlite" force="true"/>
        <server name="DB_CONNECTION" value="sqlite" force="true"/>
        <env name="DB_DATABASE" value=":memory:" force="true"/>
        <server name="DB_DATABASE" value=":memory:" force="true"/>
        <env name="DB_URL" value="" force="true"/>
        <server name="DB_URL" value="" force="true"/>
        <env name="MAIL_MAILER" value="array" force="true"/>
        <server name="MAIL_MAILER" value="array" force="true"/>
        <env name="QUEUE_CONNECTION" value="sync" force="true"/>
        <server name="QUEUE_CONNECTION" value="sync" force="true"/>
        <!-- External AI and APIs are never called from tests: they are faked where needed. -->
        <env name="AI_ENABLED" value="false" force="true"/>
        <server name="AI_ENABLED" value="false" force="true"/>
        <env name="AI_RETRY_DELAY_MS" value="0" force="true"/>
        <server name="AI_RETRY_DELAY_MS" value="0" force="true"/>
        <env name="ANTHROPIC_API_KEY" value="" force="true"/>
        <server name="ANTHROPIC_API_KEY" value="" force="true"/>
        <env name="GEMINI_API_KEY" value="" force="true"/>
        <server name="GEMINI_API_KEY" value="" force="true"/>
        <env name="GROQ_API_KEY" value="" force="true"/>
        <server name="GROQ_API_KEY" value="" force="true"/>
        <env name="OPENROUTER_API_KEY" value="" force="true"/>
        <server name="OPENROUTER_API_KEY" value="" force="true"/>
        <env name="MISTRAL_API_KEY" value="" force="true"/>
        <server name="MISTRAL_API_KEY" value="" force="true"/>
        <env name="OLLAMA_BASE_URL" value="" force="true"/>
        <server name="OLLAMA_BASE_URL" value="" force="true"/>
        <env name="GITHUB_API_TOKEN" value="" force="true"/>
        <server name="GITHUB_API_TOKEN" value="" force="true"/>
        <env name="SESSION_DRIVER" value="array" force="true"/>
        <server name="SESSION_DRIVER" value="array" force="true"/>
        <env name="REDIS_CLIENT" value="phpredis" force="true"/>
        <server name="REDIS_CLIENT" value="phpredis" force="true"/>
        <env name="SECURITY_CSP_ENABLED" value="false" force="true"/>
        <server name="SECURITY_CSP_ENABLED" value="false" force="true"/>
        <env name="LOG_CHANNEL" value="null" force="true"/>
        <server name="LOG_CHANNEL" value="null" force="true"/>
        <env name="PULSE_ENABLED" value="false" force="true"/>
        <server name="PULSE_ENABLED" value="false" force="true"/>
        <env name="TELESCOPE_ENABLED" value="false" force="true"/>
        <server name="TELESCOPE_ENABLED" value="false" force="true"/>
        <env name="NIGHTWATCH_ENABLED" value="false" force="true"/>
        <server name="NIGHTWATCH_ENABLED" value="false" force="true"/>
    </php>
</phpunit>
